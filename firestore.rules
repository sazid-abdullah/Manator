rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email.lower() == 'abdullahsazid109@gmail.com';
    }

    match /upgrade_requests/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow read, write: if isOwner();
    }

    match /users/{userId}/data/billing {
      allow read: if request.auth != null && request.auth.uid == userId || isOwner();
      allow write: if isOwner() || (request.auth != null && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingRequest', 'updatedAt']));
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId || isOwner();
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
